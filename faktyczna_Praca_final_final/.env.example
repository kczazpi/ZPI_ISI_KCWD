# ==============================================================================
# Environment Configuration Template (Zero-Secrets)
# Note: Never commit production credentials or actual secret keys to git.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Secure E2EE Notes"
API_V1_PREFIX="/api/v1"

# Domain & CORS Configuration (comma-separated list of origins)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# PostgreSQL Database Configuration
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=change_this_to_a_secure_password_in_production
POSTGRES_DB=secure_notes_db

# Asynchronous Database Connection URL
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres_user:change_this_to_a_secure_password_in_production@db:5432/secure_notes_db

# Security & Authentication Settings
# Generate a cryptographically strong key with: openssl rand -hex 32
SECRET_KEY=replace_with_64_character_hex_string_generated_by_openssl
SESSION_COOKIE_NAME=e2ee_session_id
SESSION_MAX_AGE_SECONDS=604800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Argon2id Server-Side Password Hashing Parameters
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=1

# Rate Limiting Configuration (requests per unit of time)
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_REGISTER="3/hour"
RATE_LIMIT_DEFAULT="100/minute"
